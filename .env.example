# Insert your Google Maps Demo Key into .env locally; never commit .env.
GOOGLE_MAPS_API_KEY=

# Active provider; no automatic fallback to a different provider or paid model.
LLM_PROVIDER=yandex
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=aliceai-llm-flash

# Optional Groq rollback: set LLM_PROVIDER=groq explicitly.
GROQ_API_KEY=
# GPT-OSS uses automatic provider prompt caching; see docs/model-migration.md.
GROQ_MODEL=openai/gpt-oss-120b
