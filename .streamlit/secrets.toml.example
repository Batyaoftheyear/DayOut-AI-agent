# Copy these fields into Streamlit Community Cloud -> Advanced settings -> Secrets.
# Locally use .env or copy this file to .streamlit/secrets.toml (ignored by Git).
LLM_PROVIDER = "yandex"
YANDEX_API_KEY = "your-yandex-api-key"
YANDEX_FOLDER_ID = "your-folder-id"
YANDEX_MODEL = "aliceai-llm-flash"
GOOGLE_MAPS_API_KEY = "your-google-maps-api-key"
# Optional explicit rollback (LLM_PROVIDER = "groq"):
# GROQ_API_KEY = "your-groq-api-key"
# GROQ_MODEL = "openai/gpt-oss-120b"
